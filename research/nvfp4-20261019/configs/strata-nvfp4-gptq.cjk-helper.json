{
 "exe": "<STRATA_DIR>/engine/strata",
 "args": [
  "--pack",
  "<MODEL_DIR>/pack",
  "--native",
  "<MODEL_DIR>/qwen-nvfp4-gptq-dense.gguf",
  "--native-dense-gguf",
  "<MODEL_DIR>/qwen-nvfp4-gptq-dense.gguf",
  "--ple-gguf",
  "<MODEL_DIR>/ple-fp8.gguf",
  "--embd-gguf",
  "<MODEL_DIR>/token-embd-bf16.gguf",
  "--expert-profile",
  "<STRATA_DIR>/data/expert-profile.bin",
  "--expert-cache",
  "auto",
  "--prefill",
  "auto",
  "--spec",
  "6",
  "--spec-min-p",
  "0.7",
  "--mtp",
  "<MODEL_DIR>/mtp-cjk",
  "--max-context",
  "262144",
  "--kv",
  "int8",
  "--kv-resident",
  "32768",
  "--vram-reserve-mib",
  "1000",
  "--control-vector-scaled",
  "<STRATA_DIR>/data/uncensor/qwen-nvfp4-gptq-uncensored.gguf:1.0",
  "--control-vector-layer-range",
  "8",
  "33",
  "--cvec-mode",
  "project",
  "--cvec-dir",
  "per-layer",
  "--expert-cache-device1",
  "auto",
  "--remote-expert-opt"
 ],
 "cwd": "<STRATA_DIR>",
 "tokenizer": "<MODEL_DIR>/pack/tokenizer",
 "model_name": "Qwen3.8-Flash-Next",
 "log": "<STRATA_DIR>/strata-nvfp4-gptq.log",
 "port": 8080,
 "gpu": [
  0
 ],
 "gpus_asked": true,
 "open_browser": false,
 "env": {
  "CUDA_VISIBLE_DEVICES": "0,1",
  "CUDA_DEVICE_ORDER": "PCI_BUS_ID"
 },
 "uncensored": true,
 "reasoning_budget_tokens": 32768,
 "sampling": {
  "presence_penalty": 0
 },
 "api_key": "<YOUR_API_KEY>"
}